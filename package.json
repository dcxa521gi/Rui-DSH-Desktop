{
  "name": "rui-dsh-desktop",
  "productName": "Rui DSH Desktop",
  "version": "0.2.5",
  "description": "Unofficial desktop shell for DeepSeek Harness. Double-click to run the official web UI without installing Node.js.",
  "license": "MIT",
  "author": "Rui",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/dcxa521gi/Rui-DSH-Desktop.git"
  },
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-static.mjs && node scripts/generate-icon.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run start",
    "dist": "npm run build && node scripts/dist-win.mjs --publish never",
    "dist:win": "npm run build && node scripts/dist-win.mjs --win nsis --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "smoke": "node scripts/smoke-dsh-web.mjs",
    "check:upstream": "node scripts/check-upstream.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "^1.0.1",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "pnpm": "11.7.0",
    "qrcode-generator": "^1.4.4"
  },
  "optionalDependencies": {
    "@koromix/koffi-win32-x64": "^3.1.6"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.2"
  }
}
